# ── Database (PostgreSQL) ──────────────────────────────────────────────
DB_HOST=postgres
DB_USER=postgres
DB_PASSWORD=change-me-in-production
POSTGRES_DB=anticheat

# ── Gateway ────────────────────────────────────────────────────────────
# REQUIRED: generate a strong random secret, e.g.: openssl rand -hex 32
JWT_SECRET=change-me-in-production
AUTH_PORT=8081
# Comma-separated list of allowed WebSocket origins, e.g.: http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ── ML Service ─────────────────────────────────────────────────────────
# REQUIRED: shared secret between analysis-service and ml-service
ML_SERVICE_TOKEN=change-me-in-production
AUTH_TOKEN=change-me-in-production
STOCKFISH_PATH=/usr/games/stockfish
# Number of concurrent Stockfish workers (default: 10)
STOCKFISH_WORKERS=10

# ── Analysis Service ──────────────────────────────────────────────────
CHESS_INSIGHTS_URL=http://ml-service:5002/predict

# ── User Service ───────────────────────────────────────────────────────
SMTP_USER=your-smtp-email@gmail.com
SMTP_PASSWORD=change-me-in-production

# ── gRPC Service Discovery ─────────────────────────────────────────────
USER_SERVICE_HOST=user-service
USER_SERVICE_GRPC_PORT=9090
GAME_SERVICE_HOST=game-service
GAME_SERVICE_GRPC_PORT=9091
ANALYSIS_SERVICE_HOST=analysis-service
ANALYSIS_SERVICE_GRPC_PORT=9092

# ── Redis (gateway rate limiting / password-reset codes) ───────────────
REDIS_HOST=redis
REDIS_PORT=6379
